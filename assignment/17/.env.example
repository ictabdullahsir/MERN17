# এই ফাইলটি কপি করে .env নামে সেভ করুন, তারপর নিজের তথ্য বসান।
# লোকাল MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/student-management

# MongoDB Atlas (<user>, <password> বদলান; ডাটাবেসের নাম /student-management লক্ষ্য করুন):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/student-management?retryWrites=true&w=majority

# যদি "querySrv ECONNREFUSED" এরর আসে: Atlas → Connect → Drivers → Node.js
# → Version "2.2.12 or later" বদলে "2.2.12 or earlier" বেছে নিন, তারপর যে
# mongodb://host1:27017,host2:27017,host3:27017/... স্ট্রিং পাবেন সেটা বসান:
# MONGODB_URI=mongodb://<user>:<password>@ac-xxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-02.xxxxx.mongodb.net:27017/student-management?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
